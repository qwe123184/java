@echo off
chcp 936 >nul
REM ============================================================
REM  斩神 - 一键启动前后端 (GBK + CRLF)
REM  顺序: 先后端(8081), 后前端(5173)
REM  各端脚本会自动补齐依赖/jar, 并在就绪后返回.
REM  已在运行的一端会被识别为"已在运行", 既不重复启动也不误报失败.
REM  最后会调用 status.bat 打印真实状态.
REM ============================================================
setlocal

echo ============================================================
echo   斩神 一键启动 (先后端 8081, 后前端 5173)
echo ============================================================
echo [1/2] 启动后端...
echo.
call "%~dp0springBootTest\start-backend.bat" /nopause
echo.
echo [2/2] 启动前端...
echo.
call "%~dp0start-frontend.bat" /nopause
echo.
echo ============================================================
echo   启动流程结束, 当前实际状态:
echo ============================================================
echo.
call "%~dp0status.bat" /nopause
if /i not "%~1"=="/nopause" pause
endlocal
exit /b 0
